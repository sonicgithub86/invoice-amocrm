{
  "name": "sonicexpert/amocrm-license-invoice",
  "description": "Standalone amoCRM licence invoice service",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-zip": "*",
    "amocrm/amocrm-api-library": "^1.17",
    "phpoffice/phpword": "^1.3",
    "symfony/console": "^7.2",
    "symfony/dotenv": "^7.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "InvoiceService\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InvoiceService\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "php -l bin/console && find app config database public tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "test:integration": "phpunit --testsuite Integration",
    "test:document": "phpunit --testsuite Document",
    "qa": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
