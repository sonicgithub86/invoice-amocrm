# This file contains deployment selectors, not application credentials.
INVOICE_SERVICE_IMAGE=invoice-service:release-YYYYMMDD-GIT_SHA
INVOICE_SERVICE_ENV_FILE=/opt/invoice-service/secrets/invoice-service.env
POSTGRES_ENV_FILE=/opt/invoice-service/secrets/postgres.env
COMPOSE_OVERLAY=/opt/invoice-service/deploy/compose.vps.yaml
PUBLIC_BASE_URL=https://invoice.sonic.expert
EVIDENCE_DIR=/var/lib/invoice-service-deploy/evidence
