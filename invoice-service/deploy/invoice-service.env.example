APP_BASE_URL=https://invoices.example.com
POSTGRES_DB=invoice_service
POSTGRES_USER=invoice_service
DATABASE_URL=pgsql:host=db;port=5432;dbname=invoice_service
DATABASE_USER=invoice_service
DATABASE_PASSWORD=replace-with-db-password
POSTGRES_PASSWORD=replace-with-db-password
AMO_CLIENT_ID=replace-with-external-integration-client-id
AMO_CLIENT_SECRET=replace-with-external-integration-client-secret
AMO_CREDENTIAL_KEY_V1=replace-with-base64-encoded-32-byte-key
OPERATOR_ACCESS_TOKEN=replace-with-long-random-operator-secret
AMO_REDIRECT_PATH=/oauth/callback
